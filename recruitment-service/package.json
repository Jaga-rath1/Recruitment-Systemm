{
  "name": "nexnuv-recruitment-service",
  "version": "1.0.0",
  "description": "NEXNUV Recruitment Enterprise SaaS Microservice (Node.js, Express, PostgreSQL, Sequelize)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:local": "node scripts/dev-local-postgres.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.15.6",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.5",
    "@electric-sql/pglite-socket": "^0.0.10",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
