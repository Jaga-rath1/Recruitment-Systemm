# Server
NODE_ENV=development
PORT=4007
SERVICE_NAME=nexnuv-recruitment-service
API_PREFIX=/api/v1
CLIENT_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000

# PostgreSQL Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/recruitment_service?sslmode=require
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000

# Integration Mode
# - standalone: built-in dev/contract adapters when shared services are offline (blocked in NODE_ENV=production)
# - live: synchronous REST communication with NEXNUV shared services
INTEGRATION_MODE=standalone

# Internal Service-to-Service Auth (must match shared services' INTERNAL_SERVICE_TOKEN in live mode)
INTERNAL_SERVICE_TOKEN=nexnuv-internal-service-token-dev
EXTERNAL_REQUEST_TIMEOUT_MS=5000
EXTERNAL_GET_RETRY_ATTEMPTS=2

# Shared Microservices URLs & Verified Local Ports
API_GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4001
PLATFORM_SERVICE_URL=http://localhost:4002
ORGANISATION_SERVICE_URL=http://localhost:4003
EMPLOYEE_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4006
# Optional external HRMS requisition endpoint (leave blank to use Recruitment manual/standalone requisitions)
HRMS_SERVICE_URL=
PLATFORM_REQUIRE_RECRUITMENT_FEATURE=false

# JWT Configuration (Candidate portal scope & standalone signing)
JWT_ISSUER=nexnuv-auth-service
JWT_AUDIENCE=nexnuv-recruitment
JWT_SECRET=dev-only-replace-in-production-nexnuv-jwt-secret-key-2026
CANDIDATE_JWT_SECRET=dev-only-replace-in-production-nexnuv-candidate-jwt-key-2026
JWT_EXPIRES_IN=8h

# Object Storage (LOCAL_SECURE for dev/single-volume, CLOUDINARY for horizontal production)
STORAGE_DRIVER=LOCAL_SECURE
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
STORAGE_LOCAL_ROOT=./storage
STORAGE_QUARANTINE_ROOT=./storage/_quarantine
STORAGE_SIGNED_URL_SECRET=dev-only-storage-signing-secret-2026
STORAGE_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_SIZE_MB=10

# Cloudinary Private Authenticated Asset Storage (Required when STORAGE_DRIVER=CLOUDINARY)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_PREFIX=nexnuv-recruitment
CLOUDINARY_TIMEOUT_MS=15000
CLOUDINARY_DOWNLOAD_TTL_SECONDS=120

# Synchronous Malware Scanning (DISABLED for dev, CLAMAV for ClamAV daemon over TCP)
MALWARE_SCANNER_MODE=DISABLED
MALWARE_SCAN_REQUIRED=false
QUARANTINE_INFECTED_FILES=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=5000
MALWARE_SCAN_MAX_BYTES=15728640

# Candidate Identity Verification, Recovery & Transactional Email (Phase 4.4)
CANDIDATE_TOKEN_HASH_SECRET=dev-only-replace-in-production-candidate-token-hash-secret-2026
CANDIDATE_OTP_TTL_MINUTES=10
CANDIDATE_OTP_MAX_ATTEMPTS=5
CANDIDATE_OTP_LOCK_MINUTES=15
CANDIDATE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
CANDIDATE_RESET_TTL_MINUTES=30
CANDIDATE_RESET_MAX_ATTEMPTS=5
CANDIDATE_RESET_COOLDOWN_SECONDS=60
CANDIDATE_LOGIN_MAX_ATTEMPTS=5
CANDIDATE_LOGIN_LOCK_MINUTES=15

# Direct Recruitment Transactional Email Provider (DISABLED | RESEND | BREVO | SMTP)
EMAIL_PROVIDER=DISABLED
ALLOW_UNCONFIGURED_EMAIL_IN_PRODUCTION=false
EMAIL_FROM=noreply@nexnuv.local
EMAIL_FROM_NAME=NEXNUV Recruitment
EMAIL_TIMEOUT_MS=10000
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Rate Limiting & Logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
LOG_LEVEL=info

# Notification Delivery Webhook Cryptographic Authentication (Phase 5)
# Set RESEND_WEBHOOK_SECRET for Resend (Svix whsec_...) or NOTIFICATION_WEBHOOK_SECRET for generic/SMTP HMAC
RESEND_WEBHOOK_SECRET=
BREVO_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# Treasury & Remittance Settlement Configuration (Required for active INR wire/UPI instructions)
TREASURY_BANK_NAME=
TREASURY_ACCOUNT_NUMBER=
TREASURY_IFSC_CODE=
TREASURY_UPI_ID=
TREASURY_BENEFICIARY_NAME=

