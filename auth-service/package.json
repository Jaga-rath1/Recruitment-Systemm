{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Unified Authentication and Authorization service for NexNuv HRMS and Helpdesk",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "resend": "^6.32.1",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.2.0",
    "sequelize-cli": "^6.6.2"
  }
}
