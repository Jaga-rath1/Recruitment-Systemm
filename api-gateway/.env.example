NODE_ENV=development
PORT=4000
JWT_SECRET=your_local_jwt_secret
AUTH_SERVICE_URL=http://localhost:4001
PLATFORM_SERVICE_URL=http://localhost:4002
ORGANIZATION_SERVICE_URL=http://localhost:4003
EMPLOYEE_SERVICE_URL=http://localhost:4004
ATTENDANCE_LEAVE_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
SERVICE_NAME=api-gateway

INTERNAL_SERVICE_TOKEN=your_shared_internal_service_token

# Browser origins allowed to call the gateway, comma separated. Leave blank only in local development (allows any origin).
CORS_ORIGINS=http://localhost:3000

# How long (ms) the gateway trusts an account before re-checking that it is still active with the same role.
SESSION_CHECK_TTL_MS=30000

# Helpdesk Microservices URLs
TICKET_SERVICE_URL=http://localhost:4002
TEAM_SERVICE_URL=http://localhost:4002
AGENT_SERVICE_URL=http://localhost:4002
SLA_SERVICE_URL=http://localhost:4002
ATTACHMENT_SERVICE_URL=http://localhost:4002
KNOWLEDGE_BASE_SERVICE_URL=http://localhost:4002
